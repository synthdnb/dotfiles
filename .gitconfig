[init]
	defaultBranch = main
[user]
	name = Marshall Kim
	email = marshall@vessl.ai
[core]
	editor = nvim
	excludesFile = ~/.gitignore
	pager = hunk pager
[pull]
	ff = only
[push]
	autoSetupRemote = true
[url "git@github.com:"]
	insteadOf = https://github.com/
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
