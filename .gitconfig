[init]
	defaultBranch = main
[user]
	name = Marshall Kim
	email = marshall@vessl.ai
[core]
	editor = nvim
	excludesFile = ~/.gitignore
	pager = hunk pager
[pull]
	ff = only
[push]
	autoSetupRemote = true
# OS-specific part: install.sh links .gitconfig.macos or .gitconfig.linux here
# (GitHub transport + credential helper differ: ssh key on the Mac, gh token on Linux).
[include]
	path = ~/.gitconfig.os
